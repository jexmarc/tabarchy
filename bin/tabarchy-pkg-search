#!/usr/bin/env python3
"""Search packages. Print TSV: name, repo, installed, description.

Default: Arch/Omarchy repos then the AUR.
--installed: only packages already on this machine.
"""

import re
import subprocess
import sys

MAX_ROWS = 40


def run(cmd, timeout):
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.stdout or ""
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return ""


def parse_search(text):
    rows = []
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        match = re.match(r"^([A-Za-z0-9_+.-]+)/([A-Za-z0-9@._+-]+)\s+(\S+)(.*)$", line)
        if not match:
            i += 1
            continue
        repo = match.group(1)
        name = match.group(2)
        version = match.group(3)
        rest = match.group(4).lower()
        installed = "installed" in rest
        description = ""
        if i + 1 < len(lines) and lines[i + 1][:1] in (" ", "\t"):
            description = lines[i + 1].strip()
            i += 2
        else:
            i += 1
        rows.append((name, repo, installed, description, version))
    return rows


def score(name, query):
    lower = name.lower()
    needle = query.lower()
    if lower == needle:
        return 0
    if lower.startswith(needle):
        return 1
    if needle in lower:
        return 2
    return 3


def aur_reachable():
    try:
        return subprocess.run(
            ["omarchy-pkg-aur-accessible"],
            capture_output=True,
            timeout=4,
        ).returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False


def emit(rows, query):
    seen = set()
    merged = []
    for name, repo, installed, description, version in rows:
        if name in seen:
            continue
        seen.add(name)
        merged.append((name, repo, installed, description, version))

    merged.sort(key=lambda row: (score(row[0], query), 0 if row[1] != "aur" else 1, row[0].lower()))

    for name, repo, installed, description, version in merged[:MAX_ROWS]:
        description = description.replace("\t", " ").replace("\n", " ")
        print("\t".join([name, repo, "1" if installed else "0", description]))
    return 0


def search_installed(query):
    pattern = re.escape(query)
    rows = parse_search(run(["pacman", "-Qs", "--color=never", "--", pattern], 6))
    foreign = set()
    for name in run(["pacman", "-Qmq"], 4).split():
        if name:
            foreign.add(name)

    out = []
    for name, repo, _installed, description, version in rows:
        source = "aur" if name in foreign else "local"
        detail = description
        if version:
            detail = version + (" · " + description if description else "")
        out.append((name, source, True, detail, version))
    return emit(out, query)


def search_available(query):
    pattern = re.escape(query)
    official = parse_search(run(["pacman", "-Ss", "--color=never", "--", pattern], 6))
    aur = []
    if aur_reachable():
        aur = parse_search(run(["yay", "-Ssa", "--color=never", "--", query], 10))
    return emit(official + aur, query)


def main():
    args = sys.argv[1:]
    installed_only = False
    if args and args[0] in ("--installed", "-i"):
        installed_only = True
        args = args[1:]

    query = " ".join(args).strip()
    if len(query) < 2:
        return 0

    if installed_only:
        return search_installed(query)
    return search_available(query)


if __name__ == "__main__":
    raise SystemExit(main())
