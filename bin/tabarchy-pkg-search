#!/usr/bin/env python3
"""Search Arch/Omarchy repos and the AUR. Print TSV: name, repo, installed, description."""

import re
import subprocess
import sys

MAX_ROWS = 40


def run(cmd, timeout):
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.stdout or ""
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return ""


def parse_search(text):
    rows = []
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        match = re.match(r"^([A-Za-z0-9_+.-]+)/([A-Za-z0-9@._+-]+)\s+(\S+)(.*)$", line)
        if not match:
            i += 1
            continue
        repo = match.group(1)
        name = match.group(2)
        rest = match.group(4).lower()
        installed = "installed" in rest
        description = ""
        if i + 1 < len(lines) and lines[i + 1][:1] in (" ", "\t"):
            description = lines[i + 1].strip()
            i += 2
        else:
            i += 1
        rows.append((name, repo, installed, description))
    return rows


def score(name, query):
    lower = name.lower()
    needle = query.lower()
    if lower == needle:
        return 0
    if lower.startswith(needle):
        return 1
    if needle in lower:
        return 2
    return 3


def aur_reachable():
    try:
        return subprocess.run(
            ["omarchy-pkg-aur-accessible"],
            capture_output=True,
            timeout=4,
        ).returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False


def main():
    query = " ".join(sys.argv[1:]).strip()
    if len(query) < 2:
        return 0

    pattern = re.escape(query)
    official = parse_search(run(["pacman", "-Ss", "--color=never", "--", pattern], 6))
    aur = []
    if aur_reachable():
        aur = parse_search(run(["yay", "-Ssa", "--color=never", "--", query], 10))

    seen = set()
    merged = []
    for name, repo, installed, description in official + aur:
        if name in seen:
            continue
        seen.add(name)
        merged.append((name, repo, installed, description))

    merged.sort(key=lambda row: (score(row[0], query), 0 if row[1] != "aur" else 1, row[0].lower()))

    for name, repo, installed, description in merged[:MAX_ROWS]:
        description = description.replace("\t", " ").replace("\n", " ")
        print("\t".join([name, repo, "1" if installed else "0", description]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
