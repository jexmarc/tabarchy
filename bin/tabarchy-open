#!/bin/bash
# Open a file from f Tab.
# GUI handlers (images, PDFs, the file manager) go through xdg-open.
# Terminal handlers such as nvim.desktop do nothing from the menu overlay,
# so those — and types with no app — open in the Omarchy editor instead.
# Markdown defaults to view in omawrite, with --edit for the text editor.

set -u

mode=
if [[ ${1-} == --view || ${1-} == --edit ]]; then
  mode=${1#--}
  shift
fi

path=${1-}
if [[ -z $path ]]; then
  echo "tabarchy-open: missing path" >&2
  exit 1
fi

if [[ -d $path ]]; then
  exec uwsm-app -- xdg-open "$path"
fi

desktop_file() {
  local name=$1
  local dir
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/local/share/applications /usr/share/applications; do
    if [[ -f $dir/$name ]]; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
  done
  return 1
}

terminal_handler() {
  local name=$1
  local file
  file=$(desktop_file "$name") || return 1
  grep -qi '^Terminal=true' "$file"
}

is_markdown() {
  local lower=${path,,}
  case $lower in
    *.md|*.markdown|*.mkd|*.mdown|*.mdwn) return 0 ;;
  esac
  case ${1-} in
    text/markdown|text/x-markdown) return 0 ;;
  esac
  return 1
}

open_view() {
  if command -v omawrite >/dev/null 2>&1; then
    exec uwsm-app -- omawrite "$path"
  fi
  exec omarchy-launch-editor "$path"
}

mime=$(xdg-mime query filetype "$path" 2>/dev/null || true)

if [[ $mode == edit ]]; then
  exec omarchy-launch-editor "$path"
fi

if [[ $mode == view ]] || is_markdown "$mime"; then
  open_view
fi

desktop=$(xdg-mime query default "$mime" 2>/dev/null || true)

if [[ -n $desktop ]] && ! terminal_handler "$desktop"; then
  exec uwsm-app -- xdg-open "$path"
fi

exec omarchy-launch-editor "$path"
