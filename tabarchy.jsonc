{
  // Tabarchy: in Super+Space, type one letter, then Tab to switch into
  // a command. Tab again returns to normal menu search on that letter.
  //
  // Set a letter to false to disable a default. Add any other letter
  // to run a shell command. Placeholders:
  //   {{query}}          the rest of the line, shell-quoted
  //   {{query_encoded}}  the rest of the line, URL-encoded
  //   {{url}}            https:// prepended if the query has no scheme, quoted
  //
  // kind "files" lists matches under your home directory instead of
  // running a command. kind "packages" searches Arch, Omarchy, and the AUR
  // to install. kind "remove-packages" searches installed packages to remove.
  //
  // "aliases" are shortcuts for w Tab. Type a name to open that URL.
  // Set a name to false to drop a default. https:// is added if omitted.
  // kind "help" lists every enabled command. Default letter is ?.

  "m": {
    "name": "maps",
    "icon": "󰗵",
    "placeholder": "address",
    "label": "Google Maps",
    "action": "omarchy-launch-browser \"https://www.google.com/maps/search/?api=1&query={{query_encoded}}\""
  },
  "w": {
    "name": "web",
    "icon": "󰖟",
    "placeholder": "url, search, or alias",
    "label": "Open URL or search",
    "kind": "web"
  },
  "f": {
    "name": "files",
    "icon": "",
    "placeholder": "filename",
    "kind": "files"
  },
  "i": {
    "name": "install",
    "icon": "󰏔",
    "placeholder": "package",
    "kind": "packages"
  },
  "r": {
    "name": "remove",
    "icon": "󰆴",
    "placeholder": "package",
    "kind": "remove-packages"
  },
  "?": {
    "name": "help",
    "icon": "󰋖",
    "kind": "help"
  },

  "aliases": {
    "amazon": "https://amazon.com/",
    "discord": "https://discord.com/",
    "gh": "https://github.com/",
    "op": "https://plugins.omarchy.org/"
  }
}
